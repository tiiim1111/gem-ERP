{
  // Preset for buildable workspace libraries (@gemerp/shared, @gemerp/database).
  // The extending package sets its own "outDir", "rootDir", and "include".
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "incremental": true
  }
}
