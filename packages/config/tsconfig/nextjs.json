{
  // Preset for the Next.js App Router app (@gemerp/web).
  // Next.js compiles via its own bundler, so noEmit is on and module resolution
  // is "Bundler". The app's tsconfig adds "include" and the .next type stubs.
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "noEmit": true,
    "allowJs": true,
    "incremental": true,
    "plugins": [{ "name": "next" }]
  }
}
