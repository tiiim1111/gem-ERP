{
  "extends": "@gemerp/config/tsconfig/library.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noEmitOnError": true,
    "composite": false,
    "incremental": false
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}
