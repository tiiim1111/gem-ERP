{
  "name": "@gemerp/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared constants and types for GEM ERP (permission catalog, role definitions, API contracts).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@gemerp/config": "workspace:*",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22"
  }
}
