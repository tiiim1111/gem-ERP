{
  "name": "gemerp",
  "version": "0.1.0",
  "private": true,
  "description": "GEM ERP \u2014 Asset & Inventory Management for GEM Cor (single company, multi-branch)",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @gemerp/database generate",
    "db:migrate": "pnpm --filter @gemerp/database migrate:deploy",
    "db:seed": "pnpm --filter @gemerp/database seed",
    "db:migrate:dev": "pnpm --filter @gemerp/database migrate:dev",
    "db:studio": "pnpm --filter @gemerp/database studio"
  },
  "devDependencies": {
    "@gemerp/config": "workspace:*",
    "eslint": "^9.25.0",
    "prettier": "^3.5.3",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3"
  }
}
