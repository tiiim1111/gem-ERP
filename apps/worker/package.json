{
  "name": "@gemerp/worker",
  "version": "0.1.0",
  "private": true,
  "description": "BullMQ background job runner for GEM ERP \u2014 consumes the maintenance-reminders, notifications, and report-exports queues",
  "type": "commonjs",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1103.0",
    "@gemerp/database": "workspace:*",
    "@gemerp/reports": "workspace:*",
    "@gemerp/shared": "workspace:*",
    "@prisma/client": "^6.5.0",
    "bullmq": "^5.34.0",
    "ioredis": "^5.4.2",
    "pino": "^9.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@gemerp/config": "workspace:*",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}
