# ==============================================================================
# GEM ERP — environment variables (development defaults)
#
# Copy to .env and adjust:   cp .env.example .env
# Values below match docker-compose.yml and are DEV-ONLY. Every variable is
# validated with zod at process start — apps fail fast if one is missing or
# malformed. Never commit a real .env file.
# ==============================================================================

# ------------------------------------------------------------------------------
# Runtime
# ------------------------------------------------------------------------------
# development | test | production
NODE_ENV=development

# ------------------------------------------------------------------------------
# Database (used by: api, worker, packages/database)
# Postgres 16 from docker-compose.yml (service "postgres")
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://gemerp:gemerp_dev_password@localhost:5433/gemerp

# ------------------------------------------------------------------------------
# Redis / BullMQ (used by: api, worker)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# API server (apps/api — NestJS, global prefix /api/v1, Swagger at /api/docs)
# ------------------------------------------------------------------------------
API_PORT=3001
# Browser origin allowed by CORS + used for cookie scoping (the Next.js app)
# Comma-separated allowed origins; FIRST one is used for generated links (QR scan URLs)
WEB_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# Sessions (apps/api)
# Opaque 256-bit tokens, stored SHA-256-hashed in user_sessions, 12h sliding
# expiry. Cookie is always HTTP-only, SameSite=Lax.
# ------------------------------------------------------------------------------
SESSION_COOKIE_NAME=gemerp_session
SESSION_TTL_HOURS=12
# Set to true in production (cookie only sent over HTTPS)
SESSION_COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# Web app (apps/web — Next.js; NEXT_PUBLIC_* values are exposed to the browser)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# ------------------------------------------------------------------------------
# Object storage (used by: api, worker) — MinIO from docker-compose.yml.
# Any S3-compatible endpoint works in production.
# ------------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=gemerp
S3_SECRET_KEY=gemerp_dev_password
S3_BUCKET=gemerp-attachments
# Required true for MinIO (path-style URLs instead of virtual-hosted buckets)
S3_FORCE_PATH_STYLE=true

# ------------------------------------------------------------------------------
# HRIS employee feed (used by: api, worker)
#
# Employees are read from the HRIS, which is the system of record for them.
# Read-only: GEM-ENI never writes back. See
# docs/hris-employee-api-phase2-decisions.md for the agreed contract.
#
# Leave GEMENI_HRIS_SYNC_ENABLED=false until a dry run, the code mappings and
# the default branch have all been reviewed. Everything keeps working with the
# feed off — employees are then maintained by hand as before.
# ------------------------------------------------------------------------------
GEMENI_HRIS_SYNC_ENABLED=false
GEMENI_HRIS_BASE_URL=http://192.168.0.60
GEMENI_HRIS_EMPLOYEE_PATH=/api/v1/integrations/gemeni/employees
# Asserted against meta.companyCode on every page. Employee numbers are unique
# only per company in the HRIS while GEM-ENI's constraint is global, so a
# payload from another company is refused rather than imported.
GEMENI_HRIS_EXPECTED_COMPANY_CODE=GEM
# Bearer token. Never commit a real value — set it in .env.prod on the server.
GEMENI_HRIS_TOKEN=
# The HRIS has no branch concept and GEM-ENI requires one, so new employees are
# filed under this branch code. Never reapplied to an employee that already
# exists, so a manual reassignment sticks.
GEMENI_HRIS_DEFAULT_BRANCH_CODE=
# Nightly schedule for the worker's repeatable job.
GEMENI_HRIS_SYNC_CRON=0 2 * * *
GEMENI_HRIS_SYNC_TIMEZONE=Asia/Manila
