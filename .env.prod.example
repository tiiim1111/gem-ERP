# ==============================================================================
# GEM-ENI — on-premise production environment
#
#   cp .env.prod.example .env.prod   &&   nano .env.prod
#
# Used by docker-compose.prod.yml only. NEVER commit the real .env.prod.
# Generate every password with:  openssl rand -base64 24 | tr -d '/+=' | head -c 24
# Use letters and digits only — these values go inside connection URLs.
# ==============================================================================

# ------------------------------------------------------------------------------
# How users reach the app  (THE most important setting)
# ------------------------------------------------------------------------------
# Exactly what people type in the browser. nginx serves the app on port 80, so
# there is normally no port in the URL. The FIRST entry is embedded in generated
# QR/scan URLs, so it must be the address phones on the office Wi-Fi can open.
# Examples:
#   WEB_ORIGIN=http://192.168.0.50
#   WEB_ORIGIN=http://gemeni.gemcor.local
#   WEB_ORIGIN=https://gemeni.gemcor.com.ph
# Extra origins are allowed, comma-separated (no spaces).
WEB_ORIGIN=http://192.168.0.50

# Port the nginx proxy listens on. 80 = no port in the URL. Change only if
# something else on the server already owns port 80.
HTTP_PORT=80

# true ONLY if WEB_ORIGIN starts with https://.
# Setting true on a plain http:// site makes the login cookie get dropped and
# NOBODY can sign in — the most common on-prem deployment mistake.
SESSION_COOKIE_SECURE=false

# Hours before an idle session expires (1-168).
SESSION_TTL_HOURS=12

# ------------------------------------------------------------------------------
# Database
# ------------------------------------------------------------------------------
POSTGRES_DB=gemerp
POSTGRES_USER=gemerp
POSTGRES_PASSWORD=CHANGEME_generate_a_long_random_value

# ------------------------------------------------------------------------------
# Redis (background jobs)
# ------------------------------------------------------------------------------
REDIS_PASSWORD=CHANGEME_generate_a_long_random_value

# ------------------------------------------------------------------------------
# File storage (MinIO) — powers attachments and report exports.
# Keep S3_ENABLED=true on-premise; the whole stack is local anyway.
# ------------------------------------------------------------------------------
S3_ENABLED=true
S3_ACCESS_KEY=gemeni
S3_SECRET_KEY=CHANGEME_generate_a_long_random_value
S3_BUCKET=gemerp-attachments
S3_REGION=us-east-1
# MinIO admin console port on the host (set to 0 or comment the ports line in
# docker-compose.prod.yml to close it off entirely).
MINIO_CONSOLE_PORT=9001

# ------------------------------------------------------------------------------
# Logging: fatal | error | warn | info | debug | trace
# ------------------------------------------------------------------------------
LOG_LEVEL=info
